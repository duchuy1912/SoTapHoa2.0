<style>
  * {
    box-sizing: border-box;
  }

  .navbar {
    background: linear-gradient(90deg, #1f2933, #111827);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  .logo {
    font-size: 18px;
    font-weight: bold;
  }

  .nav-links {
    display: flex;
    gap: 16px;
  }

  .nav-links a {
    color: #e5e7eb;
    text-decoration: none;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 6px;
    transition: all 0.25s ease;
  }

  .nav-links a:hover {
    background: #f59e0b;
    color: #111;
    transform: translateY(-2px);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .user-avatar-link {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.14);
    background: #111827;
    cursor: pointer;
  }

  .user-avatar-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .user-dropdown {
    position: absolute;
    right: 0;
    top: 58px;
    min-width: 180px;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 100;
  }

  .user-dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .user-dropdown a {
    display: block;
    padding: 12px 16px;
    color: #f8fafc;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .user-dropdown a:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .user-dropdown-header {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    color: #cbd5e1;
  }

  /* Nút menu mobile */
  .menu-btn {
    font-size: 24px;
    cursor: pointer;
    display: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .menu-btn {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 60px;
      right: 20px;
      background: #111827;
      flex-direction: column;
      width: 200px;
      padding: 12px;
      border-radius: 8px;
      display: none;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }

    .nav-links a {
      padding: 10px;
    }

    .nav-links.show {
      display: flex;
    }
  }
</style>

<div class="navbar">
  <div class="logo">
    🛒 Quản lý
  </div>

  <span class="menu-btn" onclick="toggleMenu()">☰</span>

  <div class="nav-links" id="navLinks">
    <a href="/">🏠 Sản phẩm</a>
    <!-- <a href="/products/create">➕ Thêm hàng</a> -->
    <a href="/imports">📦 Nhập hàng</a>
    <a href="/reports">📊 Báo cáo</a>
    <a href="/debts">📒 Ghi nợ</a>
  </div>

  <div class="nav-actions">
    <% const defaultAvatar = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'%3E%3Crect width='120' height='120' rx='20' fill='%234f8cff'/%3E%3Ccircle cx='60' cy='44' r='22' fill='%23fff'/%3E%3Cpath d='M30 97c0-18 14-32 30-32s30 14 30 32' fill='none' stroke='%23fff' stroke-width='10' stroke-linecap='round'/%3E%3C/svg%3E"; %>
    <% if (user) { %>
      <div class="user-avatar-link" onclick="toggleUserDropdown()" title="<%= user.full_name || user.email %>">
        <img src="<%= user.avatar_url || defaultAvatar %>" alt="Avatar">
      </div>
      <div class="user-dropdown" id="userDropdown">
        <div class="user-dropdown-header">
          <strong><%= user.full_name || user.email %></strong><br>
          <span><%= user.email %></span>
        </div>
        <a href="/auth/logout">Đăng xuất</a>
      </div>
    <% } else { %>
      <a href="/auth/login" class="logout-btn">Đăng nhập</a>
    <% } %>
  </div>
</div>

<script>
  function toggleMenu() {
    const navLinks = document.getElementById('navLinks');
    navLinks.classList.toggle('show');
  }

  function toggleUserDropdown() {
    const dropdown = document.getElementById('userDropdown');
    dropdown.classList.toggle('show');
  }

  document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('userDropdown');
    const avatar = document.querySelector('.user-avatar-link');
    if (!dropdown || !avatar) return;
    if (!dropdown.contains(event.target) && !avatar.contains(event.target)) {
      dropdown.classList.remove('show');
    }
  });
</script>
