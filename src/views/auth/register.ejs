<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng ký</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --border-focus: rgba(79,140,255,0.5);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: linear-gradient(135deg, #0f1117 0%, #1a1d27 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .register-container {
      width: 100%;
      max-width: 450px;
    }

    .register-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .register-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .register-header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--accent);
    }

    .register-header p {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--text);
    }

    .form-group input {
      width: 100%;
      padding: 10px 12px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.95rem;
      transition: border-color 0.2s;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--border-focus);
    }

    .password-requirements {
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .requirement {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .requirement.met {
      color: var(--accent2);
    }

    .requirement::before {
      content: "✗";
      font-weight: bold;
      width: 16px;
    }

    .requirement.met::before {
      content: "✓";
    }

    .register-btn {
      width: 100%;
      padding: 12px;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
      margin: 20px 0;
    }

    .register-btn:hover {
      background: #3d6bd4;
    }

    .register-btn:active {
      transform: translateY(1px);
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 16px 0;
      gap: 12px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .social-login {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    .social-btn {
      flex: 1;
      padding: 10px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .social-btn:hover {
      background: var(--border);
      border-color: var(--accent);
    }

    .login-link {
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .login-link a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .login-link a:hover {
      text-decoration: underline;
    }

    .error-message {
      background: rgba(255, 87, 87, 0.1);
      border: 1px solid var(--danger);
      color: var(--danger);
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 0.9rem;
    }

    .terms {
      font-size: 0.85rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 16px;
    }

    .terms a {
      color: var(--accent);
      text-decoration: none;
    }

    @media (max-width: 480px) {
      .register-card {
        padding: 24px 16px;
      }

      .register-header h1 {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="register-container">
    <div class="register-card">
      <div class="register-header">
        <h1>👋 Đăng Ký</h1>
        <p>Tạo tài khoản ShopPOS của bạn</p>
      </div>

      <% if (error) { %>
      <div class="error-message"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/register">
        <div class="form-group">
          <label for="fullName">Tên đầy đủ</label>
          <input type="text" id="fullName" name="fullName" placeholder="Nhập tên của bạn" required>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required>
        </div>

        <div class="form-group">
          <label for="password">Mật khẩu</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required oninput="checkPassword()">
          <div class="password-requirements">
            <div class="requirement" id="length">Ít nhất 6 ký tự</div>
            <div class="requirement" id="number">Chứa ít nhất 1 số</div>
            <div class="requirement" id="special">Chứa ít nhất 1 ký tự đặc biệt</div>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Xác nhận mật khẩu</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
        </div>

        <div class="terms">
          Bằng cách đăng ký, bạn đồng ý với <a href="#">Điều khoản dịch vụ</a> của chúng tôi
        </div>

        <button type="submit" class="register-btn">🚀 Đăng Ký</button>
      </form>

      <div class="divider">
        hoặc tiếp tục với
      </div>

      <div class="social-login">
        <a href="/auth/google" class="social-btn">
          <span><ion-icon name="logo-google"></ion-icon></span> Google
        </a>
      </div>

      <p class="login-link">
        Đã có tài khoản? <a href="/auth/login">Đăng nhập</a>
      </p>
    </div>
  </div>

  <script>
    function checkPassword() {
      const password = document.getElementById('password').value;

      // Kiểm tra độ dài
      const lengthCheck = document.getElementById('length');
      if (password.length >= 6) {
        lengthCheck.classList.add('met');
      } else {
        lengthCheck.classList.remove('met');
      }

      // Kiểm tra số
      const numberCheck = document.getElementById('number');
      if (/\d/.test(password)) {
        numberCheck.classList.add('met');
      } else {
        numberCheck.classList.remove('met');
      }

      // Kiểm tra ký tự đặc biệt
      const specialCheck = document.getElementById('special');
      if (/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) {
        specialCheck.classList.add('met');
      } else {
        specialCheck.classList.remove('met');
      }
    }
  </script>
  <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>
</html>