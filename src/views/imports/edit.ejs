<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sửa nhập hàng</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --border-focus: rgba(79,140,255,0.5);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      background: rgba(26, 29, 39, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 0 36px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo {
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--accent);
      letter-spacing: -0.3px;
      margin-right: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-dot {
      width: 8px; height: 8px;
      background: var(--accent2);
      border-radius: 50%;
      display: inline-block;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.88rem;
      padding: 6px 14px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .nav-links a:hover {
      background: var(--surface2);
      color: var(--text);
    }

    .nav-links a.active {
      background: rgba(79,140,255,0.15);
      color: var(--accent);
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 22px;
      cursor: pointer;
      padding: 4px;
    }

    .container {
      /* max-width: 800px; */
      margin: 0 auto;
      padding: 24px 36px;
    }

    .form-card {
      background: var(--surface);
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 24px;
    }

    .section {
      margin-bottom: 24px;
    }

    .section-title {
      font-weight: 600;
      margin-bottom: 16px;
      color: var(--accent);
    }

    .field {
      margin-bottom: 16px;
    }

    .field label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
    }

    .field input, .field select, .field textarea {
      width: 100%;
      padding: 10px 12px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
    }

    .field input:focus, .field select:focus, .field textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--border-focus);
    }

    .item-row {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr auto;
      gap: 12px;
      align-items: end;
      margin-bottom: 12px;
      padding: 12px;
      background: var(--surface2);
      border-radius: 8px;
    }

    .item-row select, .item-row input {
      padding: 8px 10px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
    }

    .btn-remove {
      background: var(--danger);
      color: white;
      border: none;
      padding: 8px;
      border-radius: 6px;
      cursor: pointer;
    }

    .btn-add {
      background: var(--accent2);
      color: var(--bg);
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 500;
    }

    .form-actions {
      display: flex;
      justify-content: space-between;
      margin-top: 24px;
    }

    .btn-back {
      background: var(--muted);
      color: var(--text);
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: 500;
    }

    .btn-save {
      background: var(--accent);
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: 500;
      cursor: pointer;
    }
  </style>

  <!-- Tom Select Custom Styles -->
  <style>
    .ts-wrapper {
      background: var(--surface2) !important;
      border: 1px solid var(--border) !important;
      border-radius: 8px !important;
    }

    .ts-wrapper.focus {
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 2px var(--border-focus) !important;
    }

    .ts-control {
      background: var(--surface2) !important;
      color: var(--text) !important;
      border: none !important;
      padding: 8px 10px !important;
      border-radius: 6px !important;
    }

    .ts-control input {
      color: var(--text) !important;
    }

    .ts-dropdown {
      background: var(--surface) !important;
      border: 1px solid var(--border) !important;
      border-radius: 8px !important;
      box-shadow: 0 4px 24px rgba(0,0,0,0.35) !important;
    }

    .ts-dropdown .option {
      color: var(--text) !important;
      padding: 8px 12px !important;
    }

    .ts-dropdown .option:hover {
      background: var(--surface2) !important;
    }

    .ts-dropdown .active {
      background: rgba(79,140,255,0.15) !important;
      color: var(--accent) !important;
    }

    .ts-wrapper .ts-control > .item {
      background: var(--accent) !important;
      color: white !important;
      border-radius: 4px !important;
    }
  </style>
</head>
<body>
    <!-- ===== NAVBAR ===== -->
  <nav class="navbar">
    <div class="nav-left">
      <button class="menu-btn" onclick="toggleMenu()">☰</button>
      <div class="logo"><span class="logo-dot"></span> ShopPOS</div>
      <div class="nav-links" id="navLinks">
        <!-- <a href="/">🏠 Trang chủ</a> -->
        <a href="/products">📦 Sản phẩm</a>
        <a href="/imports" class="active">🧾 Nhập Hàng</a>
        <a href="/debts">📒 Sổ nợ</a>
        <a href="/reports">📊 Báo cáo</a>
        <a href="/settings">⚙️ Cài đặt</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="form-card">
      <h1 style="margin-bottom: 24px;">📦 Sửa nhập hàng</h1>

      <form method="POST" action="/imports/edit/<%= importData.id %>">

        <!-- Thông tin cơ bản -->
        <div class="section">
          <div class="section-title">Thông tin nhập hàng</div>

          <div class="field">
            <label>Tên nhà cung cấp <span style="color: var(--danger);">*</span></label>
            <input type="text" name="supplier_name" value="<%= importData.supplier_name %>" placeholder="VD: Công ty TNHH ABC" required>
          </div>

          <div class="field">
            <label>Ngày nhập <span style="color: var(--danger);">*</span></label>
            <input type="date" name="import_date" value="<%= new Date(importData.import_date).toISOString().split('T')[0] %>" required>
          </div>

          <div class="field">
            <label>Ghi chú</label>
            <textarea name="note" rows="3" placeholder="Ghi chú thêm..."><%= importData.note || '' %></textarea>
          </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="section">
          <div class="section-title">Danh sách sản phẩm nhập</div>

          <div id="itemList">
            <% importData.items.forEach(item => { %>
            <div class="item-row">
              <select name="product_id[]" class="product-select" onchange="updateUnits(this)" required>
                <option value="">Chọn sản phẩm</option>
                <% products.forEach(product => { %>
                <option value="<%= product.id %>" <%= product.id == item.product_id ? 'selected' : '' %>><%= product.name %></option>
                <% }) %>
              </select>
              <select name="unit_id[]" required>
                <option value="">Đơn vị</option>
                <% products.find(p => p.id == item.product_id).units.forEach(unit => { %>
                <option value="<%= unit.id %>" <%= unit.id == item.unit_id ? 'selected' : '' %>><%= unit.unit_name %></option>
                <% }) %>
              </select>
              <input name="quantity[]" type="number" value="<%= item.quantity %>" placeholder="Số lượng" min="1" required>
              <input name="price_buy[]" type="number" value="<%= item.price_buy %>" placeholder="Giá nhập (đ)" min="0" step="0.01" required>
              <button type="button" class="btn-remove" onclick="removeItem(this)">✕</button>
            </div>
            <% }) %>
          </div>

          <button type="button" class="btn-add" onclick="addItem()">＋ Thêm sản phẩm</button>
        </div>

        <!-- Actions -->
        <div class="form-actions">
          <a href="/imports" class="btn-back">↩ Quay lại</a>
          <button type="submit" class="btn-save">💾 Cập nhật</button>
        </div>

      </form>
    </div>
  </div>

  <script type="application/json" id="products-data">
    <%- JSON.stringify(products) %>
  </script>

  <script>
    const products = JSON.parse(document.getElementById('products-data').textContent);

    // Khởi tạo Tom Select cho tất cả product selects
    function initProductSelects() {
      document.querySelectorAll('.product-select').forEach(select => {
        if (!select.tomselect) {
          new TomSelect(select, {
            placeholder: 'Tìm kiếm sản phẩm...',
            create: false,
            maxOptions: null,
            sortField: {field: "text", direction: "asc"}
          });
        }
      });
    }

    function updateUnits(select) {
      const row = select.closest('.item-row');
      const unitSelect = row.querySelector('select[name="unit_id[]"]');
      const productId = select.value;

      unitSelect.innerHTML = '<option value="">Đơn vị</option>';
      if (productId) {
        const product = products.find(p => p.id == productId);
        if (product && product.units) {
          product.units.forEach(unit => {
            const option = document.createElement('option');
            option.value = unit.id;
            option.textContent = unit.unit_name;
            unitSelect.appendChild(option);
          });
        }
      }
    }

    function addItem() {
      const itemList = document.getElementById('itemList');
      const newRow = document.createElement('div');
      newRow.className = 'item-row';
      const productOptions = products.map(product => `<option value="${product.id}">${product.name}</option>`).join('');
      newRow.innerHTML = `
        <select name="product_id[]" class="product-select" onchange="updateUnits(this)" required>
          <option value="">Chọn sản phẩm</option>
          ${productOptions}
        </select>
        <select name="unit_id[]" required>
          <option value="">Đơn vị</option>
        </select>
        <input name="quantity[]" type="number" placeholder="Số lượng" min="1" required>
        <input name="price_buy[]" type="number" placeholder="Giá nhập (đ)" min="0" step="0.01" required>
        <button type="button" class="btn-remove" onclick="removeItem(this)">✕</button>
      `;
      itemList.appendChild(newRow);

      // Khởi tạo Tom Select cho select mới ngay lập tức
      const newSelect = newRow.querySelector('.product-select');
      if (newSelect) {
        new TomSelect(newSelect, {
          placeholder: 'Tìm kiếm sản phẩm...',
          create: false,
          maxOptions: null,
          sortField: {field: "text", direction: "asc"}
        });
      }
    }

    function removeItem(btn) {
      const row = btn.closest('.item-row');
      if (document.querySelectorAll('.item-row').length > 1) {
        // Hủy Tom Select trước khi xóa
        const select = row.querySelector('.product-select');
        if (select && select.tomselect) {
          select.tomselect.destroy();
        }
        row.remove();
      }
    }

    // Khởi tạo selects khi trang load
    document.addEventListener('DOMContentLoaded', function() {
      initProductSelects();
    });
  </script>
</body>
</html>