<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Cập nhật ghi nợ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --border-focus: rgba(79,140,255,0.5);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      background: rgba(26,29,39,0.92);
      backdrop-filter: blur(14px);
      padding: 0 36px;
      height: 60px;
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-left { display: flex; align-items: center; gap: 8px; }

    .logo {
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--accent);
      margin-right: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-dot { width: 8px; height: 8px; background: var(--accent2); border-radius: 50%; }

    .nav-links { display: flex; align-items: center; gap: 4px; }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.88rem;
      padding: 6px 14px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .nav-links a:hover { background: var(--surface2); color: var(--text); }
    .nav-links a.active { background: rgba(79,140,255,0.15); color: var(--accent); }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 22px;
      cursor: pointer;
    }

    /* ===== PAGE ===== */
    .page {
      display: flex;
      justify-content: center;
      padding: 40px 16px 60px;
    }

    .container {
      width: 100%;
      max-width: 500px;
      animation: fade-up 0.4s ease both;
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Breadcrumb */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 24px;
    }

    .breadcrumb a { color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--text); }
    .breadcrumb span { color: var(--text); }

    /* Card */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 32px;
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .card-icon {
      width: 44px; height: 44px;
      background: rgba(79,140,255,0.12);
      border: 1px solid rgba(79,140,255,0.25);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .card-title {
      font-family: 'Sora', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .card-subtitle { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }

    /* Section */
    .section { margin-bottom: 24px; }

    .section-title {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* Field */
    .field { margin-bottom: 14px; }

    .field label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 7px;
      letter-spacing: 0.04em;
    }

    .field input,
    .field textarea {
      width: 100%;
      padding: 10px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .field input:focus,
    .field textarea:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(79,140,255,0.12);
    }

    .field input::placeholder,
    .field textarea::placeholder { color: var(--muted); }

    .field textarea {
      resize: vertical;
      min-height: 90px;
      line-height: 1.5;
    }

    /* Input prefix (for money) */
    .input-wrap {
      position: relative;
    }

    .input-wrap .prefix {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.82rem;
      color: var(--muted);
      pointer-events: none;
    }

    .input-wrap input { padding-left: 34px; }

    /* Current image preview */
    .img-preview-wrap {
      position: relative;
      display: inline-block;
      margin-bottom: 10px;
    }

    .preview-img {
      width: 100%;
      max-height: 180px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid var(--border);
      display: block;
    }

    .img-preview-label {
      position: absolute;
      bottom: 8px;
      left: 8px;
      background: rgba(15,17,23,0.75);
      font-size: 0.7rem;
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      backdrop-filter: blur(4px);
    }

    /* File input */
    .file-label {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: var(--surface2);
      border: 1px dashed rgba(255,255,255,0.15);
      border-radius: 10px;
      cursor: pointer;
      transition: border-color 0.2s;
      font-size: 0.88rem;
      color: var(--muted);
      position: relative;
    }

    .file-label:hover { border-color: var(--accent); color: var(--text); }

    .file-label input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
    }

    #file-name { pointer-events: none; }
    .file-chosen { color: var(--accent2); font-size: 0.82rem; }

    /* Actions */
    .form-actions {
      display: flex;
      gap: 10px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-save {
      flex: 1;
      padding: 13px;
      background: linear-gradient(135deg, var(--accent2), #26c6a0);
      color: #0f1117;
      border: none;
      border-radius: 10px;
      font-family: 'Sora', sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 16px rgba(56,232,181,0.22);
    }

    .btn-save:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(56,232,181,0.35);
    }

    .btn-save:active { transform: translateY(0); }

    .btn-back {
      padding: 13px 20px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .btn-back:hover { background: rgba(255,255,255,0.05); color: var(--text); }

    /* Responsive */
    @media (max-width: 600px) {
      .navbar { padding: 0 16px; }
      .nav-links {
        display: none;
        position: absolute;
        top: 60px; left: 0; right: 0;
        background: var(--surface);
        flex-direction: column;
        border-bottom: 1px solid var(--border);
        padding: 8px 0;
      }
      .nav-links.show { display: flex; }
      .nav-links a { border-radius: 0; padding: 12px 20px; }
      .menu-btn { display: block; }

      .card { padding: 20px 14px; }
      .form-actions { flex-direction: column-reverse; }
      .btn-back { justify-content: center; }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include('../partials/navbar') %>

  <div class="page">
    <div class="container">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/debts">Sổ nợ</a>
        <span>›</span>
        <span>Cập nhật ghi nợ</span>
      </div>

      <div class="card">

        <!-- Header -->
        <div class="card-header">
          <div class="card-icon">✏️</div>
          <div>
            <div class="card-title">Cập nhật ghi nợ</div>
            <div class="card-subtitle"><%= debt.customer_name %></div>
            <!-- <div class="card-subtitle">Nguyễn Văn An</div> -->
          </div>
        </div>

        <!-- FORM — EJS: action="/debts/edit/<%= debt.id %>" -->
        <form method="POST" action="/debts/edit/<%= debt.id %>" enctype="multipart/form-data">

          <!-- Thông tin khách -->
          <div class="section">
            <div class="section-title">Thông tin khách hàng</div>

            <div class="field">
              <label>Tên khách</label>
              <!-- EJS: value="<%= debt.customer_name %>" -->
              <input type="text" name="customer_name" value="<%= debt.customer_name %>" placeholder="Họ tên khách hàng">
            </div>

            <div class="field">
              <label>Số điện thoại</label>
              <!-- EJS: value="<%= debt.phone %>" -->
              <input type="text" name="phone" value="<%= debt.phone %>" placeholder="VD: 0901 234 567">
            </div>
          </div>

          <!-- Khoản nợ -->
          <div class="section">
            <div class="section-title">Khoản nợ</div>

            <div class="field">
              <label>Số tiền nợ</label>
              <div class="input-wrap">
                <span class="prefix">₫</span>
                <!-- EJS: value="<%= debt.total_money %>" -->
                <input type="number" name="total_money" value="<%= debt.total_money %>" placeholder="0">
              </div>
            </div>

            <div class="field">
              <label>Ghi chú</label>
              <!-- EJS: <%= debt.note %> -->
              <textarea name="note" placeholder="Thêm ghi chú về khoản nợ..."><%= debt.note %></textarea>
            </div>
          </div>

          <!-- Hình ảnh -->
          <div class="section">
            <div class="section-title">Hình ảnh</div>

            <% if(debt.image_url) { %>
            <div class="img-preview-wrap" style="width:100%; margin-bottom:12px;">
              <!-- EJS: <img src="<%= debt.image_url %>" class="preview-img"> -->
              <img src="<%= debt.image_url %>" class="preview-img">
              <span class="img-preview-label">Ảnh hiện tại</span>
            </div>
            <% } %>

            <div class="field">
              <label>Đổi ảnh mới (để trống nếu giữ nguyên)</label>
              <label class="file-label">
                <span>📁</span>
                <span id="file-name">Chọn ảnh mới…</span>
                <input type="file" name="image" accept="image/*" onchange="updateFileName(this)">
              </label>
            </div>

            <!-- EJS: <input type="hidden" name="old_image" value="<%= debt.image_url %>"> -->
            <input type="hidden" name="old_image" value="/uploads/debts/<%= debt.image_url %>">
          </div>

          <!-- Actions -->
          <div class="form-actions">
            <a href="/debts" class="btn-back">↩ Quay lại</a>
            <button type="submit" class="btn-save">💾 Cập nhật</button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <script>
    function updateFileName(input) {
      const el = document.getElementById("file-name");
      if (input.files[0]) {
        el.textContent = input.files[0].name;
        el.className = "file-chosen";
      } else {
        el.textContent = "Chọn ảnh mới…";
        el.className = "";
      }
    }

    function toggleMenu() {
      document.getElementById("navLinks").classList.toggle("show");
    }
  </script>

</body>
</html>