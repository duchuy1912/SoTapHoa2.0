<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sổ ghi nợ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      background: rgba(26,29,39,0.92);
      backdrop-filter: blur(14px);
      padding: 0 36px;
      height: 60px;
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-left { display: flex; align-items: center; gap: 8px; }

    .logo {
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--accent);
      margin-right: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-dot { width: 8px; height: 8px; background: var(--accent2); border-radius: 50%; }

    .nav-links { display: flex; align-items: center; gap: 4px; }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.88rem;
      padding: 6px 14px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .nav-links a:hover { background: var(--surface2); color: var(--text); }
    .nav-links a.active { background: rgba(79,140,255,0.15); color: var(--accent); }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 22px;
      cursor: pointer;
    }

    /* ===== PAGE HEADER ===== */
    .page-header {
      padding: 32px 36px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .page-title {
      font-family: 'Sora', sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .badge-count {
      background: rgba(79,140,255,0.15);
      color: var(--accent);
      font-size: 0.76rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }

    .btn-add-product {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: linear-gradient(135deg, var(--accent2), #26c6a0);
      color: #0f1117;
      border: none;
      border-radius: 10px;
      font-family: 'Sora', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 14px rgba(56,232,181,0.25);
    }

    .btn-add-product:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(56,232,181,0.38);
    }

    /* ===== SUMMARY CARDS ===== */
    .summary-row {
      display: flex;
      gap: 14px;
      padding: 20px 36px 0;
      flex-wrap: wrap;
    }

    .summary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 22px;
      flex: 1;
      min-width: 160px;
      animation: fade-up 0.4s ease both;
    }

    .summary-card:nth-child(2) { animation-delay: 0.06s; }
    .summary-card:nth-child(3) { animation-delay: 0.12s; }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .summary-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .summary-value {
      font-family: 'Sora', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
    }

    .summary-value.red { color: var(--danger); }
    .summary-value.green { color: var(--accent2); }
    .summary-value.blue { color: var(--accent); }

    /* ===== DIVIDER ===== */
    .divider {
      height: 1px;
      background: var(--border);
      margin: 20px 36px 0;
    }

    /* ===== TABLE WRAPPER ===== */
    .table-wrap {
      padding: 20px 36px 48px;
      overflow-x: auto;
      animation: fade-up 0.45s ease both;
      animation-delay: 0.1s;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--surface);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    thead tr {
      background: var(--surface2);
    }

    th {
      padding: 13px 16px;
      font-family: 'Sora', sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: center;
      white-space: nowrap;
    }

    th:first-child { text-align: left; padding-left: 20px; }

    td {
      padding: 12px 16px;
      font-size: 0.88rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      vertical-align: middle;
    }

    td:first-child { text-align: left; padding-left: 20px; }

    tbody tr {
      transition: background 0.15s;
    }

    tbody tr:hover { background: var(--surface2); }
    tbody tr:last-child td { border-bottom: none; }

    /* Thumbnail */
    .thumb {
      height: 56px;
      width: 56px;
      object-fit: cover;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      border: 1px solid var(--border);
      display: block;
    }

    .thumb:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }

    .no-img {
      width: 56px; height: 56px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: var(--muted);
    }

    /* Name cell */
    .customer-name {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .customer-phone {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Amount */
    .amount {
      font-family: 'Sora', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--danger);
    }

    /* Note */
    .note-cell {
      max-width: 180px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--muted);
      font-size: 0.83rem;
    }

    /* Date */
    .date-cell { color: var(--muted); font-size: 0.82rem; }

    /* Actions */
    .action-cell { display: flex; gap: 6px; justify-content: center; }

    .btn-edit {
      width: 32px; height: 32px;
      background: rgba(79,140,255,0.12);
      border: 1px solid rgba(79,140,255,0.25);
      border-radius: 8px;
      color: var(--accent);
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      transition: background 0.2s;
    }

    .btn-edit:hover { background: rgba(79,140,255,0.22); }

    .btn-del {
      width: 32px; height: 32px;
      background: rgba(255,87,87,0.1);
      border: 1px solid rgba(255,87,87,0.22);
      border-radius: 8px;
      color: var(--danger);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-del:hover { background: rgba(255,87,87,0.22); }

    /* Empty state */
    .empty-row td {
      padding: 48px 20px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* ===== IMAGE PREVIEW ===== */
    #previewBox {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.88);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      cursor: zoom-out;
      backdrop-filter: blur(6px);
      animation: fade-in 0.2s ease;
    }

    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

    #previewBox img {
      max-width: 88%;
      max-height: 88%;
      border-radius: 14px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      animation: pop 0.25s cubic-bezier(.175,.885,.32,1.275) both;
    }

    @keyframes pop {
      from { transform: scale(0.88); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    #previewBox .close-btn {
      position: absolute;
      top: 20px; right: 24px;
      width: 38px; height: 38px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    #previewBox .close-btn:hover { background: rgba(255,255,255,0.2); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      .navbar { padding: 0 16px; }
      .nav-links {
        display: none;
        position: absolute;
        top: 60px; left: 0; right: 0;
        background: var(--surface);
        flex-direction: column;
        border-bottom: 1px solid var(--border);
        padding: 8px 0;
      }
      .nav-links.show { display: flex; }
      .nav-links a { border-radius: 0; padding: 12px 20px; }
      .menu-btn { display: block; }

      .page-header, .summary-row, .divider { padding-left: 16px; padding-right: 16px; }
      .table-wrap { padding: 16px 16px 40px; }

      th, td { padding: 10px 10px; font-size: 0.8rem; }
      .note-cell { max-width: 100px; }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="nav-left">
      <button class="menu-btn" onclick="toggleMenu()">☰</button>
      <div class="logo"><span class="logo-dot"></span> ShopPOS</div>
      <div class="nav-links" id="navLinks">
        <!-- <a href="/">🏠 Trang chủ</a> -->
        <a href="/products">📦 Sản phẩm</a>
        <a href="/imports">🧾 Nhập Hàng</a>
        <a href="/debts" class="active">📒 Sổ nợ</a>
        <a href="/reports">📊 Báo cáo</a>
        <a href="/settings">⚙️ Cài đặt</a>
      </div>
    </div>
  </nav>

  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="page-title">
      📒 Sổ ghi nợ
      <span class="badge-count"><%= debts.length %> khách</span>
      <!-- <span class="badge-count" id="debtCount">3 khách</span> -->
    </div>
    <a href="/debts/create" class="btn-add-product">＋ Thêm ghi nợ</a>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="summary-row">
    <div class="summary-card">
      <div class="summary-label">Tổng khách nợ</div>
      <div class="summary-value blue"><%= debts.length %></div>
      <!-- <div class="summary-value blue">3</div> -->
    </div>
    <div class="summary-card">
      <div class="summary-label">Tổng tiền nợ</div>
      <div class="summary-value red"><%= debts.reduce((s,d)=>s+Number(d.total_money),0).toLocaleString() %> đ</div>
      <!-- <div class="summary-value red">4.250.000 đ</div> -->
    </div>
    
  </div>

  <div class="divider"></div>

  <!-- TABLE -->
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Ảnh</th>
          <th>Khách hàng</th>
          <th>Số tiền nợ</th>
          <th>Ghi chú</th>
          <th>Ngày</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>



             <% if(debts.length === 0) { %>
             <tr class="empty-row"><td colspan="6">📭 Chưa có ghi nợ nào.</td></tr>
             <% } %>
             <% debts.forEach(d => { %>
             <tr>
               <td>
                 <% if(d.image_url) { %>
                   <img src="<%= d.image_url %>" class="thumb" onclick="openPreview('<%= d.image_url %>')">
                 <% } else { %>
                   <div class="no-img">👤</div>
                 <% } %>
               </td>
               <td>
                 <div class="customer-name"><%= d.customer_name %></div>
                 <div class="customer-phone"><%= d.phone %></div>
               </td>
               <td><span class="amount"><%= Number(d.total_money).toLocaleString() %> đ</span></td>
               <td><div class="note-cell" title="<%= d.note %>"><%= d.note || '—' %></div></td>
               <td class="date-cell"><%= new Date(d.created_at).toLocaleDateString('vi-VN') %></td>
               <td>
                 <div class="action-cell">
                   <a class="btn-edit" href="/debts/edit/<%= d.id %>" title="Sửa">✏️</a>
                   <form method="POST" action="/debts/delete/<%= d.id %>" style="display:contents"
                     onsubmit="return confirm('Xoá ghi nợ này?')">
                     <button class="btn-del" title="Xoá">🗑</button>
                   </form>
                 </div>
               </td>
             </tr>
             <% }) %>


