    <div class="nav-left">
      <button class="menu-btn" onclick="toggleMenu()" aria-label="Menu">☰</button>
      <div class="logo">
        <span class="logo-dot"></span> ShopPOS
      </div>
      <div class="nav-links" id="navLinks">
        <a href="/" class="active">🏠 Trang chủ</a>
        <a href="/products">📦 Sản phẩm</a>
        <a href="/orders">🧾 Đơn hàng</a>
        <a href="/customers">👥 Khách hàng</a>
        <a href="/reports">📊 Báo cáo</a>
        <a href="/settings">⚙️ Cài đặt</a>
      </div>
    </div>
  </nav>

  <!-- ===== PAGE HEADER ===== -->
  <div class="page-header">
    <div>
      <div class="page-title">
         Danh sách sản phẩm
        <span class="badge-count" id="productCount">0 sản phẩm</span>
      </div>
    </div>
    <a href="/products/create" class="btn-add-product">
      ＋ Thêm sản phẩm
    </a>
  </div>

  <!-- ===== TOOLBAR ===== -->
  <div class="toolbar">
    <div class="search-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" placeholder="Tìm tên hoặc mã vạch..." onkeyup="searchProduct()">
    </div>
    <span class="shortcut-hint">/ để tìm</span>
  </div>

  <div class="divider"></div>

  <!-- ===== PRODUCT GRID ===== -->
  <div class="product-list" id="productGrid">


         <% products.forEach(product => { %>
         <div class="product" data-name="<%= product.name %>" data-barcode="<%= product.barcode || '' %>">
           <div class="img-wrap">
             <img src="<%= product.image_url %>" alt="<%= product.name %>">
             <div class="img-overlay"></div>
           </div>
           <h3><%= product.name %></h3>
           <span class="unit-label">Chọn đơn vị bán</span>
           <select onchange="changePrice(this)">
             <% product.units.forEach(unit => { %>
               <option value="<%= unit.price_sell %>"><%= unit.unit_name %> — <%= unit.price_sell.toLocaleString() %> đ</option>
             <% }) %>
           </select>
           <div class="price-row">
             <span class="price-label">Thành tiền:</span>
             <span class="price">0</span>
             <span class="price-unit">đ</span>
           </div>
           <div class="action-buttons">
             <a class="btn-edit" href="/products/edit/<%= product.id %>">✏️ Sửa</a>
             <form method="POST" action="/products/delete/<%= product.id %>" onsubmit="return confirm('Xoá sản phẩm này?');">
               <!-- <button type="submit" class="btn-delete">🗑 Xoá</button> -->
             </form>
           </div>
           <div class="cart-box">
             <button class="qty-btn" onclick="changeQty(this,-1)">−</button>
             <input class="qty-input" type="text" value="1">
             <button class="qty-btn" onclick="changeQty(this,1)">+</button>
             <button class="btn-cart" onclick="addToCart(this)">＋</button>
           </div>
         </div>
         <% }) %>


