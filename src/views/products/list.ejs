  </div>

  <!-- ===== TOAST ===== -->
  <div id="toast" style="
    position:fixed; bottom:24px; right:24px; z-index:9999;
    background:#1a1d27; border:1px solid rgba(56,232,181,0.3);
    border-radius:12px; padding:14px 20px; min-width:220px;
    box-shadow:0 8px 30px rgba(0,0,0,0.4);
    transform:translateY(80px); opacity:0;
    transition:all 0.3s cubic-bezier(.175,.885,.32,1.275);
    font-family:'Be Vietnam Pro',sans-serif; color:#e8eaf6; font-size:0.88rem;">
  </div>

  <!-- Scripts -->
  <script>
    // ---- Init prices ----
    window.onload = () => {
      document.querySelectorAll(".product select").forEach(s => changePrice(s));
      updateCount();
    };

    function updateCount() {
      const visible = [...document.querySelectorAll(".product")].filter(p => p.style.display !== "none").length;
      document.getElementById("productCount").textContent = visible + " sản phẩm";
    }

    // ---- Price ----
    function changePrice(select) {
      const product = select.closest(".product");
      const unitPrice = Number(select.value);
      const qty = Number(product.querySelector(".qty-input").value || 1);
      product.querySelector(".price").innerText = (unitPrice * qty).toLocaleString("vi-VN");
    }

    // ---- Qty ----
    function changeQty(btn, delta) {
      const product = btn.closest(".product");
      const input = product.querySelector(".qty-input");
      let qty = parseInt(input.value) || 1;
      qty = Math.max(1, qty + delta);
      input.value = qty;
      changePrice(product.querySelector("select"));
    }

    // ---- Search ----
    function removeVietnameseTones(str) {
      return str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/đ/g,"d");
    }

    function searchProduct() {
      const kw = removeVietnameseTones(document.getElementById("searchInput").value);
      let visible = 0;
      document.querySelectorAll(".product").forEach(p => {
        const match = removeVietnameseTones(p.dataset.name).includes(kw)
                   || removeVietnameseTones(p.dataset.barcode || "").includes(kw);
        p.style.display = match ? "block" : "none";
        if (match) visible++;
      });
      document.getElementById("emptyState").style.display = visible === 0 ? "block" : "none";
      document.getElementById("productCount").textContent = visible + " sản phẩm";
    }

    // ---- Cart ----
    function addToCart(btn) {
      const product = btn.closest(".product");
      const name = product.dataset.name;
      const select = product.querySelector("select");
      const unitName = select.options[select.selectedIndex].text.split("—")[0].trim();
      const qty = product.querySelector(".qty-input").value;
      const total = product.querySelector(".price").innerText;
      showToast(`✅ ${name} × ${qty} (${unitName})\n💰 ${total} đ`);
    }

    // ---- Toast ----
    function showToast(msg) {
      const t = document.getElementById("toast");
      t.innerHTML = msg.replace(/\n/g,"<br>");
      t.style.transform = "translateY(0)";
      t.style.opacity = "1";
      clearTimeout(t._timer);
      t._timer = setTimeout(() => {
        t.style.transform = "translateY(80px)";
        t.style.opacity = "0";
      }, 2800);
    }

    // ---- Keyboard shortcut ----
    document.addEventListener("keydown", e => {
      if (["INPUT","TEXTAREA","SELECT"].includes(document.activeElement.tagName)) return;
      if (e.key === "/" || e.key === "`") {
        e.preventDefault();
        const inp = document.getElementById("searchInput");
        inp.focus(); inp.select();
      }
    });

    // ---- Responsive menu ----
    function toggleMenu() {
      document.getElementById("navLinks").classList.toggle("show");
    }
  </script>

  <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
