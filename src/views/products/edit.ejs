<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sửa sản phẩm</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --border-focus: rgba(79,140,255,0.5);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --success: #22c55e;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      background: rgba(26,29,39,0.92);
      backdrop-filter: blur(14px);
      padding: 0 36px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-left { display: flex; align-items: center; gap: 8px; }

    .logo {
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--accent);
      letter-spacing: -0.3px;
      margin-right: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-dot { width: 8px; height: 8px; background: var(--accent2); border-radius: 50%; }

    .nav-links { display: flex; align-items: center; gap: 4px; }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.88rem;
      padding: 6px 14px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .nav-links a:hover { background: var(--surface2); color: var(--text); }
    .nav-links a.active { background: rgba(79,140,255,0.15); color: var(--accent); }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 22px;
      cursor: pointer;
    }

    /* ===== PAGE WRAPPER ===== */
    .page {
      display: flex;
      justify-content: center;
      padding: 40px 16px 60px;
    }

    /* ===== CONTAINER ===== */
    .container {
      width: 100%;
      max-width: 560px;
      animation: fade-up 0.45s ease both;
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 24px;
    }

    .breadcrumb a { color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--text); }
    .breadcrumb span { color: var(--text); }

    /* ===== CARD ===== */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 32px;
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .card-icon {
      width: 44px; height: 44px;
      background: rgba(79,140,255,0.12);
      border: 1px solid rgba(79,140,255,0.25);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .card-title {
      font-family: 'Sora', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text);
    }

    .card-subtitle {
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 2px;
    }

    /* ===== SECTION ===== */
    .section { margin-bottom: 24px; }

    .section-title {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* ===== FIELD ===== */
    .field { margin-bottom: 16px; }

    .field label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 7px;
      letter-spacing: 0.04em;
    }

    .field input[type="text"],
    .field input[type="number"],
    .field input:not([type="file"]):not([type="hidden"]) {
      width: 100%;
      padding: 10px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .field input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(79,140,255,0.12);
    }

    .field input::placeholder { color: var(--muted); }

    /* File input */
    .file-wrap {
      position: relative;
    }

    .file-label {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: var(--surface2);
      border: 1px dashed rgba(255,255,255,0.15);
      border-radius: 10px;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
      font-size: 0.88rem;
      color: var(--muted);
    }

    .file-label:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    .file-label input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .file-icon { font-size: 1.1rem; }
    .file-name { font-size: 0.82rem; color: var(--accent2); margin-top: 5px; }

    /* ===== UNITS ===== */
    #units-container { display: flex; flex-direction: column; gap: 10px; }

    .unit-row {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 12px;
      transition: border-color 0.2s;
      animation: slide-in 0.25s ease both;
    }

    @keyframes slide-in {
      from { opacity: 0; transform: translateX(-10px); }
      to   { opacity: 1; transform: translateX(0); }
    }

    .unit-row:hover { border-color: rgba(255,255,255,0.14); }

    .unit-row input {
      flex: 1;
      padding: 8px 10px;
      background: var(--bg);
      border: 1px solid transparent;
      border-radius: 8px;
      color: var(--text);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.86rem;
      outline: none;
      transition: border-color 0.2s;
      min-width: 0;
    }

    .unit-row input:focus { border-color: var(--border-focus); }
    .unit-row input::placeholder { color: var(--muted); font-size: 0.82rem; }

    .unit-row .price-input { max-width: 120px; }

    .btn-remove {
      width: 30px; height: 30px;
      background: rgba(255,87,87,0.1);
      border: 1px solid rgba(255,87,87,0.2);
      border-radius: 8px;
      color: var(--danger);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
      transition: background 0.2s;
    }

    .btn-remove:hover { background: rgba(255,87,87,0.22); }

    /* ===== BUTTONS ===== */
    .btn-add-unit {
      width: 100%;
      padding: 10px;
      background: rgba(79,140,255,0.08);
      border: 1px dashed rgba(79,140,255,0.3);
      border-radius: 10px;
      color: var(--accent);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 4px;
      transition: background 0.2s, border-color 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-add-unit:hover { background: rgba(79,140,255,0.15); border-color: rgba(79,140,255,0.5); }

    .form-actions {
      display: flex;
      gap: 10px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-save {
      flex: 1;
      padding: 12px;
      background: linear-gradient(135deg, var(--accent2), #26c6a0);
      color: #0f1117;
      border: none;
      border-radius: 10px;
      font-family: 'Sora', sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      box-shadow: 0 4px 16px rgba(56,232,181,0.25);
    }

    .btn-save:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(56,232,181,0.35);
    }

    .btn-save:active { transform: translateY(0); }

    .btn-back {
      padding: 12px 20px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .btn-back:hover { background: rgba(255,255,255,0.05); color: var(--text); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 600px) {
      .navbar { padding: 0 16px; }
      .nav-links {
        display: none;
        position: absolute;
        top: 60px; left: 0; right: 0;
        background: var(--surface);
        flex-direction: column;
        border-bottom: 1px solid var(--border);
        padding: 8px 0;
      }
      .nav-links.show { display: flex; }
      .nav-links a { border-radius: 0; padding: 12px 20px; }
      .menu-btn { display: block; }

      .card { padding: 20px 16px; }
      .form-actions { flex-direction: column-reverse; }
      .btn-back { justify-content: center; }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="nav-left">
      <button class="menu-btn" onclick="toggleMenu()">☰</button>
      <div class="logo"><span class="logo-dot"></span> ShopPOS</div>
      <div class="nav-links" id="navLinks">
        <!-- <a href="/">🏠 Trang chủ</a> -->
        <a href="/products" class="active">📦 Sản phẩm</a>
        <a href="/imports">🧾 Nhập Hàng</a>
        <a href="/debts">📒 Sổ nợ</a>
        <a href="/reports">📊 Báo cáo</a>
        <a href="/settings">⚙️ Cài đặt</a>
      </div>
    </div>
  </nav>


  <div class="page">
    <div class="container">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/products">Sản phẩm</a>
        <span>›</span>
        <span>Sửa sản phẩm</span>
      </div>

      <div class="card">

        <!-- Header -->
        <div class="card-header">
          <div class="card-icon">✏️</div>
          <div>
            <div class="card-title">Sửa sản phẩm</div>
            <!-- Trong EJS thật: <div class="card-subtitle">ID: <%= product.id %></div> -->
            <div class="card-subtitle">ID: <%= product.id %></div>
          </div>
        </div>

        <!-- FORM — trong EJS thật: action="/products/edit/<%= product.id %>" -->
        <form action="/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">

          <!-- Thông tin cơ bản -->
          <div class="section">
            <div class="section-title">Thông tin cơ bản</div>

            <div class="field">
              <label>Tên sản phẩm</label>
              <!-- EJS: value="<%= product.name %>" -->
              <input type="text" name="name" value="<%= product.name %>" placeholder="Nhập tên sản phẩm" required>
            </div>

            <div class="field">
              <label>Mã barcode</label>
              <!-- EJS: value="<%= product.barcode %>" -->
              <input type="text" name="barcode" value="<%= product.barcode %>" placeholder="Nhập mã vạch (tuỳ chọn)">
            </div>
          </div>

          <!-- Hình ảnh -->
          <div class="section">
            <div class="section-title">Hình ảnh</div>

            <div class="field">
              <label>Đổi hình ảnh (để trống nếu giữ nguyên)</label>
              <div class="file-wrap">
                <label class="file-label">
                  <span class="file-icon">📁</span>
                  <span id="file-text">Chọn file ảnh…</span>
                  <input type="file" name="image" accept="image/*" onchange="updateFileName(this)">
                </label>
              </div>
              <!-- EJS: value="<%= product.image_url %>" -->
              <input type="hidden" name="old_image"  value="<%= product.image_url %>">
            </div>
          </div>

          <!-- Đơn vị bán -->
          <div class="section">
            <div class="section-title">Đơn vị bán</div>

            <div id="units-container">
              <% product.units.forEach(unit => { %>
              <div class="unit-row">
                <input type="hidden" name="unit_id[]" value="<%= unit.id %>">
                <input name="unit_name[]" value="<%= unit.unit_name %>" placeholder="Hộp / Lốc / Thùng">
                <input name="price_sell[]" value="<%= unit.price_sell %>" placeholder="Giá bán" class="price-input">
                <button type="button" class="btn-remove" onclick="removeUnit(this)" title="Xoá">✕</button>
              </div>
              <% }) %>
             

              <!-- Demo rows -->
              <!-- <div class="unit-row">
                <input type="hidden" name="unit_id[]" value="1">
                <input name="unit_name[]" value="Lon" placeholder="Hộp / Lốc / Thùng">
                <input name="price_sell[]" value="12000" placeholder="Giá bán" class="price-input">
                <button type="button" class="btn-remove" onclick="removeUnit(this)" title="Xoá">✕</button>
              </div>
              <div class="unit-row">
                <input type="hidden" name="unit_id[]" value="2">
                <input name="unit_name[]" value="Lốc 6" placeholder="Hộp / Lốc / Thùng">
                <input name="price_sell[]" value="85000" placeholder="Giá bán" class="price-input">
                <button type="button" class="btn-remove" onclick="removeUnit(this)" title="Xoá">✕</button>
              </div>
            </div> -->

            <button type="button" class="btn-add-unit" onclick="addUnit()" style="margin-top:10px">
              ＋ Thêm đơn vị
            </button>
          </div>

          <!-- Actions -->
          <div class="form-actions">
            <a href="/" class="btn-back">↩ Quay lại</a>
            <button type="submit" class="btn-save">💾 Cập nhật sản phẩm</button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <script>
    function addUnit() {
      const div = document.createElement("div");
      div.className = "unit-row";
      div.innerHTML = `
        <input type="hidden" name="unit_id[]" value="">
        <input name="unit_name[]" placeholder="Hộp / Lốc / Thùng">
        <input name="price_sell[]" placeholder="Giá bán" class="price-input">
        <button type="button" class="btn-remove" onclick="removeUnit(this)" title="Xoá">✕</button>
      `;
      document.getElementById("units-container").appendChild(div);
      div.querySelector("input[name='unit_name[]']").focus();
    }

    function removeUnit(btn) {
      const row = btn.parentElement;
      row.style.transition = "opacity 0.2s, transform 0.2s";
      row.style.opacity = "0";
      row.style.transform = "translateX(-10px)";
      setTimeout(() => row.remove(), 200);
    }

    function updateFileName(input) {
      const label = document.getElementById("file-text");
      label.textContent = input.files[0] ? input.files[0].name : "Chọn file ảnh…";
    }

    function toggleMenu() {
      document.getElementById("navLinks").classList.toggle("show");
    }
  </script>

</body>
</html>