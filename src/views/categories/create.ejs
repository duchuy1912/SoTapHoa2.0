<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Thêm loại hàng</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.08);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --text: #e8eaf6;
      --muted: #7b82a0;
      --danger: #ff6b6b;
    }
    * { box-sizing: border-box; margin:0; padding:0; }
    body { min-height: 100vh; font-family: 'Be Vietnam Pro', sans-serif; background: var(--bg); color: var(--text); }
    .page { max-width: 720px; margin: 0 auto; padding: 28px 20px; }
    .breadcrumb { display: flex; gap: 8px; color: var(--muted); margin-bottom: 18px; font-size: 0.92rem; }
    .breadcrumb a { color: var(--accent); text-decoration: none; }
    .card { background: #141824; border: 1px solid var(--border); border-radius: 24px; padding: 28px; box-shadow: 0 18px 60px rgba(0,0,0,0.35); }
    .card-header { margin-bottom: 20px; }
    .card-title { font-family: 'Sora', sans-serif; font-size: 1.6rem; font-weight: 700; }
    .card-subtitle { margin-top: 6px; color: var(--muted); }
    .field { margin-bottom: 18px; }
    .field label { display:block; font-size:0.9rem; color: var(--muted); margin-bottom:8px; font-weight:600; }
    .field input, .field textarea { width:100%; padding:12px 14px; background: var(--surface2); border:1px solid var(--border); border-radius:14px; color: var(--text); font-size:0.95rem; outline:none; }
    .field textarea { min-height:120px; resize:vertical; }
    .btn-secondary, .btn-save { display:inline-flex; align-items:center; justify-content:center; gap:8px; border:none; border-radius:999px; padding:12px 18px; font-weight:700; cursor:pointer; text-decoration:none; }
    .btn-secondary { background: rgba(255,255,255,0.08); color: var(--text); }
    .btn-save { background: linear-gradient(135deg, var(--accent2), #26c6a0); color: #0f1117; }
    .error { margin-bottom: 18px; padding: 14px 16px; background: rgba(255, 87, 87, 0.12); color: #ffb3b3; border:1px solid rgba(255,87,87,0.2); border-radius:14px; }
  </style>
</head>
<body>
    <%- include('../partials/navbar') %>
  <div class="page">
    <div class="breadcrumb">
      <a href="/">Trang chủ</a>
      <span>›</span>
      <a href="/categories">Loại hàng</a>
      <span>›</span>
      <span>Thêm loại hàng</span>
    </div>
    <div class="card">
      <div class="card-header">
        <div class="card-title">Thêm loại hàng mới</div>
        <div class="card-subtitle">Tạo loại hàng để gán cho sản phẩm trong cửa hàng.</div>
      </div>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form method="POST" action="/categories/create">
        <div class="field">
          <label>Tên loại hàng <span style="color:#ff6b6b">*</span></label>
          <input type="text" name="name" placeholder="Ví dụ: Đồ uống" required>
        </div>
        <div class="field">
          <label>Mô tả</label>
          <textarea name="description" placeholder="Mô tả ngắn về loại hàng"></textarea>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-top:10px;">
          <a href="/categories" class="btn-secondary">↩ Quay lại</a>
          <button type="submit" class="btn-save">💾 Lưu loại hàng</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
