<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng nhập — ShopPOS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: rgba(255,255,255,0.07);
      --border-focus: rgba(79,140,255,0.5);
      --accent: #4f8cff;
      --accent2: #38e8b5;
      --danger: #ff5757;
      --text: #e8eaf6;
      --muted: #7b82a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* ===== LEFT PANEL ===== */
    .panel-left {
      width: 48%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface);
    }

    .grid-bg {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(79,140,255,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(79,140,255,0.06) 1px, transparent 1px);
      background-size: 44px 44px;
    }

    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .blob-1 {
      width: 340px; height: 340px;
      background: rgba(79,140,255,0.12);
      top: -60px; left: -80px;
      animation: float1 8s ease-in-out infinite;
    }

    .blob-2 {
      width: 280px; height: 280px;
      background: rgba(56,232,181,0.09);
      bottom: -40px; right: -60px;
      animation: float2 10s ease-in-out infinite;
    }

    .blob-3 {
      width: 180px; height: 180px;
      background: rgba(79,140,255,0.07);
      top: 50%; left: 55%;
      transform: translate(-50%,-50%);
      animation: float1 12s ease-in-out infinite reverse;
    }

    @keyframes float1 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(20px, 30px); }
    }

    @keyframes float2 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-25px, -20px); }
    }

    .deco-ring {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(79,140,255,0.08);
      pointer-events: none;
    }

    .ring-1 { width: 500px; height: 500px; top: 50%; left: 50%; transform: translate(-50%,-50%); }
    .ring-2 { width: 350px; height: 350px; top: 50%; left: 50%; transform: translate(-50%,-50%); }

    .brand {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 40px;
    }

    .logo-wrap {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 36px;
      padding: 10px 20px;
      background: rgba(79,140,255,0.08);
      border: 1px solid rgba(79,140,255,0.18);
      border-radius: 14px;
    }

    .logo-icon {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--accent), #2563eb);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .logo-text {
      font-family: 'Sora', sans-serif;
      font-weight: 800;
      font-size: 1.3rem;
      color: var(--text);
      letter-spacing: -0.5px;
    }

    .logo-dot-accent {
      width: 7px; height: 7px;
      background: var(--accent2);
      border-radius: 50%;
      display: inline-block;
      margin-left: 2px;
      vertical-align: super;
    }

    .brand-headline {
      font-family: 'Sora', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.2;
      color: var(--text);
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }

    .brand-headline .highlight {
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .brand-desc {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.65;
      max-width: 280px;
      margin: 0 auto 32px;
    }

    .features {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 260px;
      margin: 0 auto;
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      text-align: left;
      animation: fade-up 0.5s ease both;
    }

    .feature-item:nth-child(1) { animation-delay: 0.1s; }
    .feature-item:nth-child(2) { animation-delay: 0.2s; }
    .feature-item:nth-child(3) { animation-delay: 0.3s; }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .feature-icon {
      width: 30px; height: 30px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
    }

    .fi-blue  { background: rgba(79,140,255,0.15); }
    .fi-green { background: rgba(56,232,181,0.12); }
    .fi-red   { background: rgba(255,87,87,0.12);  }

    .feature-text { font-size: 0.82rem; color: var(--muted); }
    .feature-text strong { color: var(--text); font-weight: 600; display: block; font-size: 0.84rem; }

    /* ===== RIGHT PANEL ===== */
    .panel-right {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
      background: var(--bg);
    }

    .form-wrap {
      width: 100%;
      max-width: 380px;
      animation: fade-up 0.5s ease both;
      animation-delay: 0.05s;
    }

    .form-heading { margin-bottom: 32px; }

    .form-heading h1 {
      font-family: 'Sora', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
      letter-spacing: -0.3px;
    }

    .form-heading p { font-size: 0.86rem; color: var(--muted); }

    .field { margin-bottom: 16px; }

    .field label {
      display: block;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .input-wrap { position: relative; }

    .input-wrap input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 0.92rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(79,140,255,0.12);
    }

    .input-wrap input::placeholder { color: var(--muted); }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 15px;
      pointer-events: none;
    }

    .toggle-pw {
      position: absolute;
      right: 13px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      font-size: 15px;
      color: var(--muted);
      user-select: none;
      transition: color 0.2s;
    }

    .toggle-pw:hover { color: var(--text); }
    .input-wrap input.has-toggle { padding-right: 42px; }

    .err-msg {
      font-size: 0.74rem;
      color: var(--danger);
      margin-top: 5px;
      display: none;
    }

    .err-msg.show { display: block; }
    input.err { border-color: var(--danger) !important; }

    .options-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      font-size: 0.82rem;
    }

    .remember {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      cursor: pointer;
      user-select: none;
    }

    .remember input[type="checkbox"] {
      accent-color: var(--accent);
      width: 14px; height: 14px;
    }

    .forgot {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
      transition: opacity 0.2s;
    }

    .forgot:hover { opacity: 0.7; }

    .btn-login {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, var(--accent2), #26c6a0);
      color: #0f1117;
      border: none;
      border-radius: 10px;
      font-family: 'Sora', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 18px rgba(56,232,181,0.25);
      position: relative;
      overflow: hidden;
    }

    .btn-login::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
      transform: translateX(-100%);
      transition: transform 0.5s ease;
    }

    .btn-login:hover { transform: translateY(-1px); box-shadow: 0 8px 26px rgba(56,232,181,0.38); }
    .btn-login:hover::after { transform: translateX(100%); }
    .btn-login:active { transform: translateY(0); }
    .btn-login.loading { pointer-events: none; opacity: 0.8; }

    .spinner {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(15,17,23,0.3);
      border-top-color: #0f1117;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 22px 0;
      font-size: 0.75rem;
      color: var(--muted);
    }

    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .register-hint {
      text-align: center;
      font-size: 0.82rem;
      color: var(--muted);
    }

    .register-hint a { color: var(--accent); text-decoration: none; font-weight: 600; }

    /* Success overlay */
    .success-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15,17,23,0.85);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(6px);
      animation: fade-in 0.25s ease;
    }

    .success-overlay.show { display: flex; }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

    .success-card {
      background: var(--surface);
      border: 1px solid rgba(56,232,181,0.25);
      border-radius: 18px;
      padding: 40px 48px;
      text-align: center;
      animation: pop 0.3s cubic-bezier(.175,.885,.32,1.275) both;
    }

    @keyframes pop {
      from { transform: scale(0.85); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    .success-icon {
      width: 56px; height: 56px;
      background: rgba(56,232,181,0.12);
      border: 1px solid rgba(56,232,181,0.3);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      font-size: 24px;
    }

    .success-card h2 {
      font-family: 'Sora', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }

    .success-card p { font-size: 0.84rem; color: var(--muted); }

    @media (max-width: 768px) {
      .panel-left { display: none; }
    }
  </style>
</head>
<body>

  <!-- LEFT PANEL -->
  <div class="panel-left">
    <div class="grid-bg"></div>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="deco-ring ring-1"></div>
    <div class="deco-ring ring-2"></div>

    <div class="brand">
      <div class="logo-wrap">
        <div class="logo-icon">🛒</div>
        <span class="logo-text">ShopPOS<span class="logo-dot-accent"></span></span>
      </div>

      <h2 class="brand-headline">
        Quản lý cửa hàng<br>
        <span class="highlight">thông minh hơn</span>
      </h2>

      <p class="brand-desc">
        Hệ thống quản lý bán hàng, ghi nợ và báo cáo dành cho các cửa hàng tạp hoá và bán lẻ.
      </p>

      <div class="features">
        <div class="feature-item">
          <div class="feature-icon fi-blue">📦</div>
          <div class="feature-text">
            <strong>Quản lý sản phẩm</strong>
            Tồn kho, đơn vị, giá bán dễ dàng
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon fi-red">📒</div>
          <div class="feature-text">
            <strong>Sổ ghi nợ</strong>
            Theo dõi công nợ khách hàng
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon fi-green">📊</div>
          <div class="feature-text">
            <strong>Báo cáo doanh thu</strong>
            Thống kê theo ngày, tháng, năm
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="panel-right">
    <div class="form-wrap">

      <div class="form-heading">
        <h1>Đăng nhập 👋</h1>
        <p>Chào mừng trở lại! Nhập thông tin tài khoản để tiếp tục.</p>
      </div>

      <!-- EJS: action="/auth/login" method="POST" -->
      <form id="loginForm" method="POST" action="/auth/login">

        <div class="field">
          <label>Tên đăng nhập</label>
          <div class="input-wrap">
            <span class="input-icon">👤</span>
            <input type="text" id="username" name="username"
              placeholder="Nhập tên đăng nhập" autocomplete="username">
          </div>
          <div class="err-msg" id="username-err">Vui lòng nhập tên đăng nhập.</div>
        </div>

        <div class="field">
          <label>Mật khẩu</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input type="password" id="password" name="password"
              placeholder="••••••••" class="has-toggle" autocomplete="current-password">
            <span class="toggle-pw" id="togglePw">👁</span>
          </div>
          <div class="err-msg" id="password-err">Mật khẩu phải có ít nhất 6 ký tự.</div>
        </div>

        <div class="options-row">
          <label class="remember">
            <input type="checkbox" name="remember"> Ghi nhớ đăng nhập
          </label>
          <a href="/auth/forgot" class="forgot">Quên mật khẩu?</a>
        </div>

        <button type="button" class="btn-login" id="btnLogin">
          <span class="spinner" id="spinner"></span>
          <span id="btn-text">🚀 Đăng nhập</span>
        </button>

      </form>

      <div class="divider">hoặc</div>

      <div class="register-hint">
        Chưa có tài khoản? <a href="/auth/register">Liên hệ quản trị viên</a>
      </div>

    </div>
  </div>

  <!-- SUCCESS OVERLAY -->
  <div class="success-overlay" id="successOverlay">
    <div class="success-card">
      <div class="success-icon">✅</div>
      <h2>Đăng nhập thành công!</h2>
      <p>Đang chuyển hướng về trang chủ…</p>
    </div>
  </div>

  <script>
    // Toggle password visibility
    document.getElementById("togglePw").addEventListener("click", function() {
      const pw = document.getElementById("password");
      const isHidden = pw.type === "password";
      pw.type = isHidden ? "text" : "password";
      this.textContent = isHidden ? "🙈" : "👁";
    });

    // Validate & submit
    document.getElementById("btnLogin").addEventListener("click", () => {
      const user    = document.getElementById("username");
      const pw      = document.getElementById("password");
      const userErr = document.getElementById("username-err");
      const pwErr   = document.getElementById("password-err");
      const btn     = document.getElementById("btnLogin");

      user.classList.remove("err"); userErr.classList.remove("show");
      pw.classList.remove("err");   pwErr.classList.remove("show");

      let valid = true;

      if (!user.value.trim()) {
        user.classList.add("err"); userErr.classList.add("show"); valid = false;
      }

      if (pw.value.length < 6) {
        pw.classList.add("err"); pwErr.classList.add("show"); valid = false;
      }

      if (!valid) return;

      // Loading state
      btn.classList.add("loading");
      document.getElementById("spinner").style.display = "block";
      document.getElementById("btn-text").textContent = "Đang xử lý…";

      // Demo — thực tế: document.getElementById("loginForm").submit();
      setTimeout(() => {
        btn.classList.remove("loading");
        document.getElementById("spinner").style.display = "none";
        document.getElementById("btn-text").textContent = "🚀 Đăng nhập";
        document.getElementById("successOverlay").classList.add("show");
      }, 1000);
    });

    // Enter key
    document.addEventListener("keydown", e => {
      if (e.key === "Enter" && document.activeElement.tagName !== "BUTTON") {
        document.getElementById("btnLogin").click();
      }
    });
  </script>

</body>
</html>